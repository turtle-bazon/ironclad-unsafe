;;;; -*- mode: lisp; indent-tabs-mode: nil -*-
;;;; xmss.lisp -- XMSS-SHA2_10_256 hash-based signatures (RFC 8391).

(in-package :crypto)

(defconstant +xmss-n+ 32)
(defconstant +xmss-padding-len+ 32)
(defconstant +xmss-full-height+ 10)
(defconstant +xmss-tree-height+ 10)
(defconstant +xmss-d+ 1)
(defconstant +xmss-w+ 16)
(defconstant +xmss-logw+ 4)
(defconstant +xmss-len1+ 64)
(defconstant +xmss-len2+ 3)
(defconstant +xmss-len+ 67)
(defconstant +xmss-wots-sig-bytes+ (* +xmss-len+ +xmss-n+))
(defconstant +xmss-index-bytes+ 4)
(defconstant +xmss-pk-bytes+ (* 2 +xmss-n+))
(defconstant +xmss-sk-bytes+ (+ +xmss-index-bytes+ (* 4 +xmss-n+)))
(defconstant +xmss-sig-bytes+ (+ +xmss-index-bytes+ +xmss-n+
                                 (* +xmss-d+ +xmss-wots-sig-bytes+)
                                 (* +xmss-full-height+ +xmss-n+)))
(defconstant +xmss-pad-f+ 0)
(defconstant +xmss-pad-h+ 1)
(defconstant +xmss-pad-hash+ 2)
(defconstant +xmss-pad-prf+ 3)
(defconstant +xmss-pad-prf-keygen+ 4)

(defun xmss-bytes (n)
  (make-array n :element-type '(unsigned-byte 8) :initial-element 0))

(defun xmss-slice (buffer offset length)
  (make-array length :element-type '(unsigned-byte 8)
              :displaced-to buffer
              :displaced-index-offset offset))

(defun xmss-ull-to-bytes (v start outlen value)
  (loop for i from (1- outlen) downto 0
        do (setf (aref v (+ start i)) (logand value #xFF))
           (setf value (ash value -8)))
  (values))

(defun xmss-bytes-to-ull (v start outlen)
  (let ((acc 0))
    (loop for i below outlen
          do (setf acc (logior (ash acc 8) (aref v (+ start i)))))
    acc))

(defun xmss-sha256-octets (octets)
  (let ((d (make-digest :sha256)))
    (update-digest d octets)
    (produce-digest d)))

;; Address helpers.
(defun xmss-alloc-addr () (make-array 8 :element-type 'integer :initial-element 0))
(defun xmss-set-layer-addr (a layer) (setf (aref a 0) layer))
(defun xmss-set-tree-addr (a tree)
  (setf (aref a 1) (ldb (byte 32 32) tree))
  (setf (aref a 2) (ldb (byte 32 0) tree)))
(defun xmss-set-type (a typ) (setf (aref a 3) typ))
(defun xmss-set-key-and-mask (a v) (setf (aref a 7) v))
(defun xmss-copy-subtree-addr (out in)
  (setf (aref out 0) (aref in 0))
  (setf (aref out 1) (aref in 1))
  (setf (aref out 2) (aref in 2)))
(defun xmss-set-ots-addr (a v) (setf (aref a 4) v))
(defun xmss-set-chain-addr (a v) (setf (aref a 5) v))
(defun xmss-set-hash-addr (a v) (setf (aref a 6) v))
(defun xmss-set-ltree-addr (a v) (setf (aref a 4) v))
(defun xmss-set-tree-height (a v) (setf (aref a 5) v))
(defun xmss-set-tree-index (a v) (setf (aref a 6) v))
(defun xmss-addr-to-bytes (addr buf start)
  (dotimes (i 8)
    (xmss-ull-to-bytes buf (+ start (* i 4)) 4 (aref addr i))))

;; PRF.
(defun xmss-prf (key in32)
  (let ((buf (xmss-bytes (+ +xmss-padding-len+ +xmss-n+ 32))))
    (xmss-ull-to-bytes buf 0 +xmss-padding-len+ +xmss-pad-prf+)
    (replace buf key :start1 +xmss-padding-len+)
    (replace buf in32 :start1 (+ +xmss-padding-len+ +xmss-n+))
    (xmss-sha256-octets buf)))
(defun xmss-prf-keygen (key inbytes)
  (let* ((inlen (length inbytes))
         (buf (xmss-bytes (+ +xmss-padding-len+ +xmss-n+ inlen))))
    (xmss-ull-to-bytes buf 0 +xmss-padding-len+ +xmss-pad-prf-keygen+)
    (replace buf key :start1 +xmss-padding-len+)
    (replace buf inbytes :start1 (+ +xmss-padding-len+ +xmss-n+))
    (xmss-sha256-octets buf)))
(defun xmss-thash (pub-seed addr in is-h)
  (if is-h
      (let* ((buf (xmss-bytes (+ +xmss-padding-len+ (* 3 +xmss-n+))))
             (bitmask (xmss-bytes (* 2 +xmss-n+)))
             (addrbytes (xmss-bytes 32)))
        (xmss-ull-to-bytes buf 0 +xmss-padding-len+ +xmss-pad-h+)
        (xmss-set-key-and-mask addr 0)
        (xmss-addr-to-bytes addr addrbytes 0)
        (replace buf (xmss-prf pub-seed addrbytes) :start1 +xmss-padding-len+)
        (xmss-set-key-and-mask addr 1)
        (xmss-addr-to-bytes addr addrbytes 0)
        (replace bitmask (xmss-prf pub-seed addrbytes) :start1 0)
        (xmss-set-key-and-mask addr 2)
        (xmss-addr-to-bytes addr addrbytes 0)
        (replace bitmask (xmss-prf pub-seed addrbytes) :start1 +xmss-n+)
        (dotimes (i (* 2 +xmss-n+))
          (setf (aref buf (+ +xmss-padding-len+ +xmss-n+ i))
                (logxor (aref in i) (aref bitmask i))))
        (xmss-sha256-octets buf))
      (let* ((buf (xmss-bytes (+ +xmss-padding-len+ (* 2 +xmss-n+))))
             (bitmask (xmss-bytes +xmss-n+))
             (addrbytes (xmss-bytes 32)))
        (xmss-ull-to-bytes buf 0 +xmss-padding-len+ +xmss-pad-f+)
        (xmss-set-key-and-mask addr 0)
        (xmss-addr-to-bytes addr addrbytes 0)
        (replace buf (xmss-prf pub-seed addrbytes) :start1 +xmss-padding-len+)
        (xmss-set-key-and-mask addr 1)
        (xmss-addr-to-bytes addr addrbytes 0)
        (replace bitmask (xmss-prf pub-seed addrbytes))
        (dotimes (i +xmss-n+)
          (setf (aref buf (+ +xmss-padding-len+ +xmss-n+ i))
                (logxor (aref in i) (aref bitmask i))))
        (xmss-sha256-octets buf))))
(defun xmss-thash-h (pub-seed addr in) (xmss-thash pub-seed addr in t))
(defun xmss-thash-f (pub-seed addr in) (xmss-thash pub-seed addr in nil))

(defun xmss-hash-message (r root idx msg)
  (let* ((prefix-len (+ +xmss-padding-len+ (* 3 +xmss-n+)))
         (buf (xmss-bytes (+ prefix-len (length msg)))))
    (xmss-ull-to-bytes buf 0 +xmss-padding-len+ +xmss-pad-hash+)
    (replace buf r :start1 +xmss-padding-len+)
    (replace buf root :start1 (+ +xmss-padding-len+ +xmss-n+))
    (xmss-ull-to-bytes buf (+ +xmss-padding-len+ (* 2 +xmss-n+)) +xmss-n+ idx)
    (replace buf msg :start1 prefix-len)
    (xmss-sha256-octets buf)))

;; WOTS.
(defun xmss-wots-expand-seed (inseed pub-seed addr out)
  (let ((buf (xmss-bytes (+ +xmss-n+ 32))))
    (replace buf pub-seed :start1 0)
    (xmss-set-hash-addr addr 0)
    (xmss-set-key-and-mask addr 0)
    (dotimes (i +xmss-len+)
      (xmss-set-chain-addr addr i)
      (xmss-addr-to-bytes addr buf +xmss-n+)
      (let ((outseed (xmss-prf-keygen inseed buf)))
        (replace out outseed :start1 (* i +xmss-n+))))))
(defun xmss-gen-chain (buf start steps pub-seed addr)
  (loop for i from start below (min (+ start steps) +xmss-w+)
        do (xmss-set-hash-addr addr i)
           (let ((new (xmss-thash-f pub-seed addr buf)))
             (replace buf new))))

(defun xmss-base-w (output out-len input)
  (let ((in 0) (out 0) (total 0) (bits 0) (consumed 0))
    (loop while (< consumed out-len)
          do (when (= bits 0)
               (setf total (aref input in))
               (incf in)
               (setf bits 8))
             (decf bits +xmss-logw+)
             (setf (aref output out)
                   (logand (ash total (- bits)) (1- +xmss-w+)))
             (incf out)
             (incf consumed))))

(defun xmss-chain-lengths (lengths msg)
  (xmss-base-w lengths +xmss-len1+ msg)
  (let ((csum 0))
    (dotimes (i +xmss-len1+)
      (incf csum (- (1- +xmss-w+) (aref lengths i))))
    (let* ((shift (- 8 (mod (* +xmss-len2+ +xmss-logw+) 8)))
           (csum (ash csum shift))
           (nbytes (ceiling (* +xmss-len2+ +xmss-logw+) 8))
           (buf (xmss-bytes nbytes))
           (tmp (make-array +xmss-len2+ :element-type 'integer)))
      (xmss-ull-to-bytes buf 0 nbytes csum)
      (xmss-base-w tmp +xmss-len2+ buf)
      (dotimes (i +xmss-len2+)
        (setf (aref lengths (+ +xmss-len1+ i)) (aref tmp i))))))

(defun xmss-wots-pkgen (pk seed pub-seed addr)
  (xmss-wots-expand-seed seed pub-seed addr pk)
  (dotimes (i +xmss-len+)
    (xmss-set-chain-addr addr i)
    (xmss-gen-chain (make-array +xmss-n+ :element-type '(unsigned-byte 8)
                                :displaced-to pk
                                :displaced-index-offset (* i +xmss-n+))
                    0 (1- +xmss-w+) pub-seed addr)))

(defun xmss-wots-sign (sig msg seed pub-seed addr)
  (let ((lengths (make-array +xmss-len+ :element-type 'integer)))
    (xmss-chain-lengths lengths msg)
    (xmss-wots-expand-seed seed pub-seed addr sig)
    (dotimes (i +xmss-len+)
      (xmss-set-chain-addr addr i)
      (xmss-gen-chain (make-array +xmss-n+ :element-type '(unsigned-byte 8)
                                  :displaced-to sig
                                  :displaced-index-offset (* i +xmss-n+))
                      0 (aref lengths i) pub-seed addr))))

(defun xmss-wots-pk-from-sig (pk sig msg pub-seed addr)
  (let ((lengths (make-array +xmss-len+ :element-type 'integer)))
    (xmss-chain-lengths lengths msg)
    (dotimes (i +xmss-len+)
      (xmss-set-chain-addr addr i)
      (let ((out (make-array +xmss-n+ :element-type '(unsigned-byte 8)
                              :displaced-to pk
                              :displaced-index-offset (* i +xmss-n+)))
            (in (make-array +xmss-n+ :element-type '(unsigned-byte 8)
                              :displaced-to sig
                              :displaced-index-offset (* i +xmss-n+))))
        (replace out in)
        (xmss-gen-chain out
                        (aref lengths i)
                        (- (1- +xmss-w+) (aref lengths i))
                        pub-seed addr))))) 

;; L-tree.
(defun xmss-l-tree (leaf wots-pk pub-seed addr)
  (let* ((pk (copy-seq wots-pk))
         (l +xmss-len+)
         (height 0))
    (xmss-set-tree-height addr height)
    (loop while (> l 1)
          do (let ((parents (ash l -1)))
               (dotimes (i parents)
                 (xmss-set-tree-index addr i)
                 (let* ((start (* (* i 2) +xmss-n+))
                        (end (* (+ (* i 2) 2) +xmss-n+))
                        (in (subseq pk start end))
                        (out (xmss-thash-h pub-seed addr in)))
                   (replace pk out :start1 (* i +xmss-n+))))
               (when (oddp l)
                 (replace pk pk :start1 (* parents +xmss-n+)
                          :start2 (* (1- l) +xmss-n+)
                          :end2 (+ (* (1- l) +xmss-n+) +xmss-n+))
                 (setf parents (1+ parents)))
               (setf l parents)
               (incf height)
               (xmss-set-tree-height addr height)))
    (replace leaf (subseq pk 0 +xmss-n+))))


(defun xmss-gen-leaf-wots (leaf sk-seed pub-seed ltree-addr ots-addr)
  (let ((wpk (xmss-bytes +xmss-wots-sig-bytes+)))
    (xmss-wots-pkgen wpk sk-seed pub-seed ots-addr)
    (xmss-l-tree leaf wpk pub-seed ltree-addr)))

;; Treehash.
(defun xmss-treehash (root auth-path sk-seed pub-seed leaf-idx subtree-addr)
  (let* ((n +xmss-n+)
         (stack (xmss-bytes (* (1+ +xmss-tree-height+) n)))
         (heights (make-array (1+ +xmss-tree-height+) :element-type 'integer :initial-element 0))
         (offset 0)
         (ots-addr (xmss-alloc-addr))
         (ltree-addr (xmss-alloc-addr))
         (node-addr (xmss-alloc-addr)))
    (xmss-copy-subtree-addr ots-addr subtree-addr)
    (xmss-copy-subtree-addr ltree-addr subtree-addr)
    (xmss-copy-subtree-addr node-addr subtree-addr)
    (xmss-set-type ots-addr 0)
    (xmss-set-type ltree-addr 1)
    (xmss-set-type node-addr 2)
    (dotimes (idx (ash 1 +xmss-tree-height+))
      (let ((lt (xmss-alloc-addr)) (ot (xmss-alloc-addr)))
        (xmss-copy-subtree-addr lt ltree-addr)
        (xmss-copy-subtree-addr ot ots-addr)
        (xmss-set-type lt 1)
        (xmss-set-type ot 0)
        (xmss-set-ltree-addr lt idx)
        (xmss-set-ots-addr ot idx)
        (xmss-gen-leaf-wots (xmss-slice stack (* offset n) n)
                              sk-seed pub-seed lt ot))
      (incf offset)
      (setf (aref heights (1- offset)) 0)
      (when (= (logxor leaf-idx 1) idx)
        (replace auth-path (subseq stack (* (- offset 1) n) (* offset n)) :start1 0))
      (loop while (and (>= offset 2)
                      (= (aref heights (1- offset)) (aref heights (- offset 2))))
            do (let* ((h (aref heights (1- offset)))
                       (tree-idx (ash idx (- (+ h 1)))))
               (xmss-set-tree-height node-addr h)
               (xmss-set-tree-index node-addr tree-idx)
               (let ((new (xmss-thash-h pub-seed node-addr
                                (subseq stack (* (- offset 2) n) (* offset n)))))
                 (replace stack new :start1 (* (- offset 2) n)))
               (decf offset)
               (incf (aref heights (1- offset)))
               (when (= (logxor (ash leaf-idx (- (aref heights (1- offset)))) 1)
                        tree-idx)
                 (let ((h2 (aref heights (1- offset))))
                   (replace auth-path
                           (subseq stack (* (1- offset) n) (* offset n))
                           :start1 (* h2 n)))))))
    (replace root (subseq stack 0 n)))
  (values))

;; Compute root from leaf + auth path.
(defun xmss-compute-root (leaf leafidx auth-path pub-seed addr nbits)
  (declare (ignore nbits))
  (let* ((n +xmss-n+)
         (buf (xmss-bytes (* 2 n)))
         (root (xmss-bytes n))
         (auth auth-path))
    (if (oddp leafidx)
        (progn (replace buf leaf :start1 n) (replace buf auth :start1 0 :end1 n))
        (progn (replace buf leaf :start1 0) (replace buf auth :start1 n :end1 (* 2 n))))
    (setf auth (subseq auth n))
    (dotimes (i (1- +xmss-tree-height+))
        (xmss-set-tree-height addr i)
        (setf leafidx (ash leafidx -1))
        (xmss-set-tree-index addr leafidx)
        (if (oddp leafidx)
            (progn
              (let ((out (xmss-thash-h pub-seed addr buf)))
                (replace buf out :start1 n))
              (replace buf auth :start1 0 :end1 n))
            (progn
              (let ((out (xmss-thash-h pub-seed addr buf)))
                (replace buf out :start1 0))
              (replace buf auth :start1 n :end1 (* 2 n))))
        (setf auth (subseq auth n)))
      (xmss-set-tree-height addr (1- +xmss-tree-height+))
      (setf leafidx (ash leafidx -1))
      (xmss-set-tree-index addr leafidx)
      (let ((out (xmss-thash-h pub-seed addr buf)))
        (replace root out))
    root))

;; Seed keypair.
(defun xmss-mt-core-seed-keypair (pk sk seed)
  (let* ((n +xmss-n+)
         (index-bytes +xmss-index-bytes+)
         (skptr index-bytes))
    (dotimes (i index-bytes) (setf (aref sk i) 0))
    (replace sk seed :start1 skptr :end1 (+ skptr (* 2 n)))
    (replace sk (subseq seed (* 2 n) (* 3 n)) :start1 (+ skptr (* 3 n)))
    (replace pk (subseq sk (+ skptr (* 3 n)) (+ skptr (* 4 n))) :start1 n)
    (let ((auth (xmss-bytes (* +xmss-tree-height+ n)))
          (top-addr (xmss-alloc-addr)))
      (xmss-set-layer-addr top-addr (1- +xmss-d+))
      (xmss-treehash pk auth (subseq sk skptr (+ skptr n)) (subseq pk n (* 2 n)) 0 top-addr)
      (replace sk pk :start1 (+ skptr (* 2 n)) :end1 (+ skptr (* 3 n)))))
  (values pk sk))

(defun xmss-keypair-from-coins (seed)
  (let ((pk (xmss-bytes +xmss-pk-bytes+))
        (sk (xmss-bytes +xmss-sk-bytes+)))
    (xmss-mt-core-seed-keypair pk sk seed)
    (values pk sk)))

(defun xmss-key-exhausted (sk)
  "Return true when an XMSS secret key has no remaining one-time signatures."
  (>= (xmss-bytes-to-ull sk 0 +xmss-index-bytes+)
      (ash 1 +xmss-full-height+)))

;; Core sign.
(defun xmss-core-sign (sk msg)
  (let* ((n +xmss-n+)
         (index-bytes +xmss-index-bytes+)
         (tree-h +xmss-tree-height+)
         (layers +xmss-d+)
         (sigbytes +xmss-sig-bytes+)
         (mlen (length msg))
         (sm (xmss-bytes (+ sigbytes mlen)))
         (idx (xmss-bytes-to-ull sk 0 index-bytes))
         (sk-seed (subseq sk index-bytes (+ index-bytes n)))
         (sk-prf (subseq sk (+ index-bytes n) (+ index-bytes (* 2 n))))
         (pub-root (subseq sk (+ index-bytes (* 2 n)) (+ index-bytes (* 3 n))))
         (pub-seed (subseq sk (+ index-bytes (* 3 n)) (+ index-bytes (* 4 n))))
         (root (xmss-bytes n)))
    (when (xmss-key-exhausted sk)
      (error 'stateful-key-exhausted
             :kind :xmss-sha2-10-256
             :index idx
             :limit (ash 1 +xmss-full-height+)))
    (replace sm msg :start1 sigbytes)
    (let ((idx-bytes (xmss-bytes index-bytes)))
      (xmss-ull-to-bytes idx-bytes 0 index-bytes idx)
      (replace sm idx-bytes :start1 0))
    (xmss-ull-to-bytes sk 0 index-bytes (1+ idx))
    (let* ((idx32 (xmss-bytes 32)))
      (xmss-ull-to-bytes idx32 0 32 idx)
      (let ((r (xmss-prf sk-prf idx32)))
        (replace sm r :start1 index-bytes)))
    (let ((mhash (xmss-hash-message (subseq sm index-bytes (+ index-bytes n)) pub-root idx msg)))
      (replace root mhash))
    (let ((sm-offset (+ index-bytes n))
          (idx-cur idx))
      (dotimes (i layers)
        (let ((idx-leaf (logand idx-cur (1- (ash 1 tree-h)))))
          (setf idx-cur (ash idx-cur (- tree-h)))
          (let ((ots-addr (xmss-alloc-addr)))
            (xmss-set-type ots-addr 0)
            (xmss-set-layer-addr ots-addr i)
            (xmss-set-tree-addr ots-addr idx-cur)
            (xmss-set-ots-addr ots-addr idx-leaf)
            (xmss-wots-sign (xmss-slice sm sm-offset +xmss-wots-sig-bytes+)
                            root sk-seed pub-seed ots-addr)
            (incf sm-offset +xmss-wots-sig-bytes+)
            (let ((auth (xmss-slice sm sm-offset (* tree-h n)))
                  (addr (xmss-alloc-addr)))
              (xmss-copy-subtree-addr addr ots-addr)
              (xmss-treehash root auth sk-seed pub-seed idx-leaf addr)
              (incf sm-offset (* tree-h n))))))
    (subseq sm 0 sigbytes)))

)
;; Core sign open.
(defun xmss-core-sign-open (pk sm)
  (let* ((n +xmss-n+)
         (index-bytes +xmss-index-bytes+)
         (sigbytes +xmss-sig-bytes+)
         (pub-root (subseq pk 0 n))
         (pub-seed (subseq pk n (* 2 n)))
         (idx (xmss-bytes-to-ull sm 0 index-bytes))
         (root (xmss-bytes n))
         (sm-offset (+ index-bytes n)))
    (let ((r (subseq sm index-bytes (+ index-bytes n)))
          (m (subseq sm sigbytes)))
      (replace root (xmss-hash-message r pub-root idx m)))
    (let ((idx-cur idx)
          (wots-pk (xmss-bytes +xmss-wots-sig-bytes+))
          (leaf (xmss-bytes n)))
      (dotimes (i +xmss-d+)
        (let ((idx-leaf (logand idx-cur (1- (ash 1 +xmss-tree-height+)))))
          (setf idx-cur (ash idx-cur (- +xmss-tree-height+)))
          (let ((ots (xmss-alloc-addr))
                (lt (xmss-alloc-addr))
                (node (xmss-alloc-addr)))
            (xmss-set-type ots 0)
            (xmss-set-type lt 1)
            (xmss-set-type node 2)
            (xmss-set-layer-addr ots i)
            (xmss-set-layer-addr lt i)
            (xmss-set-layer-addr node i)
            (xmss-set-tree-addr ots idx-cur)
            (xmss-set-tree-addr lt idx-cur)
            (xmss-set-tree-addr node idx-cur)
            (xmss-set-ots-addr ots idx-leaf)
            (xmss-set-ltree-addr lt idx-leaf)
            (xmss-wots-pk-from-sig wots-pk (subseq sm sm-offset (+ sm-offset +xmss-wots-sig-bytes+))
                                   root pub-seed ots)
            (incf sm-offset +xmss-wots-sig-bytes+)
            (xmss-l-tree leaf wots-pk pub-seed lt)
            (let ((auth (subseq sm sm-offset (+ sm-offset (* +xmss-tree-height+ n)))))
              (setf root (xmss-compute-root leaf idx-leaf auth pub-seed node (1- +xmss-tree-height+)))) ; returns new array
            (incf sm-offset (* +xmss-tree-height+ n))))))
    (if (equalp root pub-root) 0 -1)))

;; Key classes / API.
(defclass xmss-public-key ()
  ((kind :initarg :kind :reader xmss-key-kind-pub)
   (bytes :initarg :bytes :reader xmss-key-bytes-pub)))
(defclass xmss-private-key ()
  ((kind :initarg :kind :reader xmss-key-kind-priv)
   (bytes :initarg :bytes :accessor xmss-key-bytes-priv)))

(defclass xmss-sha256-h10-public-key (xmss-public-key) ())
(defclass xmss-sha256-h10-private-key (xmss-private-key) ())

(defun xmss-check-bytes (bytes len kind)
  (unless (and (typep bytes '(simple-array (unsigned-byte 8) (*)))
               (= (length bytes) len))
    (error 'missing-key-parameter :kind kind :parameter 'bytes :description "XMSS key bytes"))
  (copy-seq bytes))

(defmacro xmss-define-constructors (kind public-class private-class)
  `(progn
     (defmethod make-public-key ((kind (eql ,kind)) &key bytes &allow-other-keys)
       (make-instance ',public-class :kind ,kind
                      :bytes (xmss-check-bytes bytes +xmss-pk-bytes+ ,kind)))
     (defmethod make-private-key ((kind (eql ,kind)) &key bytes &allow-other-keys)
       (make-instance ',private-class :kind ,kind
                      :bytes (xmss-check-bytes bytes +xmss-sk-bytes+ ,kind)))
     (defmethod generate-key-pair ((kind (eql ,kind)) &key &allow-other-keys)
       (multiple-value-bind (pk sk)
           (xmss-keypair-from-coins (random-data (* 3 +xmss-n+)))
         (values (make-instance ',private-class :kind ,kind :bytes sk)
                 (make-instance ',public-class :kind ,kind :bytes pk))))))

(xmss-define-constructors :xmss-sha256-h10 xmss-sha256-h10-public-key xmss-sha256-h10-private-key)
(xmss-define-constructors :xmss-sha2-10-256 xmss-sha256-h10-public-key xmss-sha256-h10-private-key)

(defmethod destructure-public-key ((public-key xmss-public-key))
  (list :bytes (copy-seq (xmss-key-bytes-pub public-key))))
(defmethod destructure-private-key ((private-key xmss-private-key))
  (list :bytes (copy-seq (xmss-key-bytes-priv private-key))))

(defun xmss-sign-bytes (sk-bytes msg)
  (xmss-core-sign sk-bytes msg))
(defun xmss-verify-bytes (pk-bytes msg sig)
  (let ((sm (concatenate '(vector (unsigned-byte 8)) sig msg)))
    (zerop (xmss-core-sign-open pk-bytes sm))))

(defmethod sign-message ((private-key xmss-private-key) message &key &allow-other-keys)
  (let* ((msg (copy-seq message))
         (sk (xmss-key-bytes-priv private-key))
         (sig (xmss-core-sign sk msg)))
    (setf (xmss-key-bytes-priv private-key) (copy-seq sk))
    sig))

(defmethod verify-signature ((public-key xmss-public-key) message signature &key &allow-other-keys)
  (let ((pk (xmss-key-bytes-pub public-key)))
    (xmss-verify-bytes pk (copy-seq message) (copy-seq signature))))

;; Test helper function.
(defun xmss-test (file kind name pk-bytes sk-bytes sig msg)
  (declare (ignore file))
  (let ((pk (make-public-key kind :bytes pk-bytes))
        (sk (make-private-key kind :bytes sk-bytes)))
    (unless (verify-signature pk msg sig)
      (error "XMSS verification failed for ~A" name))
    (let ((sig2 (sign-message sk msg)))
      (unless (and (= (length sig2) (length sig))
                   (verify-signature pk msg sig2))
        (error "XMSS roundtrip failed for ~A" name)))
    (let ((bad (copy-seq sig)))
      (setf (aref bad 100) (logxor (aref bad 100) 1))
      (when (verify-signature pk msg bad)
        (error "XMSS tampered signature accepted for ~A" name)))))
