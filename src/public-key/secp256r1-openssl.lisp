;;;; secp256r1-openssl.lisp -- optional OpenSSL FFI backend for secp256r1
;;;; Load this file after ironclad to enable OpenSSL-accelerated verification.

(eval-when (:load-toplevel :execute)
  (require :ironclad)
  (ignore-errors (require :cffi)))

(in-package :crypto)

(when (find-package :cffi)
  (cffi:load-foreign-library "libcrypto.so.3")

  (cffi:defcfun ("EC_KEY_new_by_curve_name" %ec-key-new-by-curve-name) :pointer (nid :int))
  (cffi:defcfun ("EC_KEY_free" %ec-key-free) :void (key :pointer))
  (cffi:defcfun ("EC_KEY_get0_group" %ec-key-get0-group) :pointer (key :pointer))
  (cffi:defcfun ("EC_POINT_new" %ec-point-new) :pointer (group :pointer))
  (cffi:defcfun ("EC_POINT_free" %ec-point-free) :void (point :pointer))
  (cffi:defcfun ("EC_POINT_oct2point" %ec-point-oct2point) :int (group :pointer) (point :pointer) (buf :pointer) (len :size) (ctx :pointer))
  (cffi:defcfun ("EC_KEY_set_public_key" %ec-key-set-public-key) :int (key :pointer) (point :pointer))
  (cffi:defcfun ("ECDSA_do_verify" %ecdsa-do-verify) :int (dgst :pointer) (dgstlen :int) (sig :pointer) (eckey :pointer))
  (cffi:defcfun ("ECDSA_SIG_new" %ecdsa-sig-new) :pointer)
  (cffi:defcfun ("ECDSA_SIG_free" %ecdsa-sig-free) :void (sig :pointer))
  (cffi:defcfun ("ECDSA_SIG_set0" %ecdsa-sig-set0) :int (sig :pointer) (r :pointer) (s :pointer))
  (cffi:defcfun ("BN_bin2bn" %bn-bin2bn) :pointer (s :pointer) (len :int) (ret :pointer))
  (cffi:defcfun ("BN_CTX_new" %bn-ctx-new) :pointer)
  (cffi:defcfun ("BN_CTX_free" %bn-ctx-free) :void (ctx :pointer))

  (defconstant +p256-nid+ 415)
  (defstruct %p256-key key group ctx point pub-buf)
  (defparameter *p256-key-cache* (make-hash-table :test 'equalp))

  (defun %p256-setup (pub-octets)
    (let* ((key (%ec-key-new-by-curve-name +p256-nid+))
           (group (%ec-key-get0-group key))
           (ctx (%bn-ctx-new))
           (point (%ec-point-new group))
           (pub-buf (cffi:foreign-alloc :unsigned-char :count (length pub-octets))))
      (dotimes (i (length pub-octets))
        (setf (cffi:mem-aref pub-buf :unsigned-char i) (aref pub-octets i)))
      (%ec-point-oct2point group point pub-buf (length pub-octets) ctx)
      (%ec-key-set-public-key key point)
      (make-%p256-key :key key :group group :ctx ctx :point point :pub-buf pub-buf)))

  (defun %p256-get-key (pub-octets)
    (or (gethash pub-octets *p256-key-cache*)
        (setf (gethash pub-octets *p256-key-cache*) (%p256-setup pub-octets))))

  (defun %openssl-verify-p256 (pub-octets msg r-bytes s-bytes)
    (let* ((setup (%p256-get-key pub-octets))
           (key (%p256-key-key setup))
           (r-buf (cffi:foreign-alloc :unsigned-char :count (length r-bytes)))
           (s-buf (cffi:foreign-alloc :unsigned-char :count (length s-bytes)))
           (dgst (cffi:foreign-alloc :unsigned-char :count 32))
           (r-bn (cffi:null-pointer))
           (s-bn (cffi:null-pointer))
           (sig (%ecdsa-sig-new))
           (result 0))
      (unwind-protect
           (progn
             (dotimes (i (length r-bytes))
               (setf (cffi:mem-aref r-buf :unsigned-char i) (aref r-bytes i)))
             (dotimes (i (length s-bytes))
               (setf (cffi:mem-aref s-buf :unsigned-char i) (aref s-bytes i)))
             (dotimes (i (min 32 (length msg)))
               (setf (cffi:mem-aref dgst :unsigned-char i) (aref msg i)))
             (setf r-bn (%bn-bin2bn r-buf (length r-bytes) (cffi:null-pointer)))
             (setf s-bn (%bn-bin2bn s-buf (length s-bytes) (cffi:null-pointer)))
             (%ecdsa-sig-set0 sig r-bn s-bn)
             (setf result (%ecdsa-do-verify dgst (min 32 (length msg)) sig key)))
        (cffi:foreign-free r-buf)
        (cffi:foreign-free s-buf)
        (cffi:foreign-free dgst)
        (%ecdsa-sig-free sig))
      result))

  ;; Override verify-signature
  (defmethod verify-signature ((key secp256r1-public-key) message signature &key (start 0) end &allow-other-keys)
    (let* ((end (min (or end (length message)) (/ +secp256r1-bits+ 8)))
           (msg (subseq message start end))
           (signature-elements (destructure-signature :secp256r1 signature))
           (r (getf signature-elements :r))
           (s (getf signature-elements :s)))
      (if (and (= (length signature) (/ +secp256r1-bits+ 4))
               (< 0 (ec-decode-scalar :secp256r1 r) +secp256r1-l+)
               (< 0 (ec-decode-scalar :secp256r1 s) +secp256r1-l+))
          (= (%openssl-verify-p256 (secp256r1-key-y key) msg r s) 1)
          nil))))
