       (aref (the (simple-array (unsigned-byte 64) (*))
                  (aref upc (1- (bike-slices))))
             (ash j -3))))

(defun bike-threshold (s)
  (declare (type (simple-array (unsigned-byte 64) (*)) s)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let* ((w (bike-r-weight s))
         (coeff0 (bike-params-thr-coeff0 *bike-params*))
         (coeff1 (bike-params-thr-coeff1 *bike-params*))
         (thr (logand (+ coeff0 (* coeff1 w)) #xFFFFFFFFFFFFFFFF))
         (a-lo (logand thr #xFFFFFFFF))
         (a-hi (ash thr -32))
         (mulc 12379400392853802749)
         (b-lo (logand mulc #xFFFFFFFF))
         (b-hi (ash mulc -32)))
    (setf thr (logand (+ (* a-hi b-hi)
                         (ash (+ (* a-hi b-lo) (* a-lo b-hi)) -32))
                      #xFFFFFFFFFFFFFFFF))
    (setf thr (ash thr -26))
    (if (>= thr (bike-thr-min)) thr (bike-thr-min))))

(defun bike-compute-syndrome (s c0 h0)
  (declare (type (simple-array (unsigned-byte 64) (*)) s c0 h0)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((pad-s (bike-u64vec (bike-r-padded-qwords)))
        (rq (bike-r-qwords)))
    (declare (type fixnum rq))
    (bike-gf2x-mul pad-s c0 h0)
    (dotimes (i rq)
      (setf (aref s i) (aref pad-s i)))
    (setf (aref s (1- rq))
          (logand (aref s (1- rq)) (bike-last-qword-mask)))
    (bike-syndrome-dup s)
    (values)))

(defun bike-recompute-syndrome (s c0 h0 pk e0 e1)
  (declare (type (simple-array (unsigned-byte 64) (*)) s c0 h0 pk e0 e1)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((pad (bike-r-padded-qwords)))
    (declare (type fixnum pad))
    (let ((tmp (bike-u64vec pad))
          (pe0 (bike-u64vec pad))
          (pe1 (bike-u64vec pad)))
      (dotimes (i pad)
        (setf (aref pe0 i) (aref e0 i)
              (aref pe1 i) (aref e1 i)))
      (bike-gf2x-mul tmp pe1 pk)
      (bike-gf2x-add tmp tmp c0 pad)
      (bike-gf2x-add tmp tmp pe0 pad)
      (bike-compute-syndrome s tmp h0)
      (values))))

(defun bike-gf2x-add (c a b n)
  (declare (type (simple-array (unsigned-byte 64) (*)) c a b)
           (type fixnum n)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (dotimes (i n c)
    (setf (aref c i) (logxor (aref a i) (aref b i)))))

