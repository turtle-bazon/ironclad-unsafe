(declaim (inline bike-u64vec))
(defun bike-u64vec (n)
  (make-array n :element-type '(unsigned-byte 64) :initial-element 0))

(declaim (inline bike-u64eq))
(defun bike-u64eq (a b)
  (if (= (logand a #xFFFFFFFFFFFFFFFF) (logand b #xFFFFFFFFFFFFFFFF))
      #xFFFFFFFFFFFFFFFF 0))


;;;
;;; GF(2)[x] mod (x^r - 1): 64x64 base multiply and Karatsuba product.
;;;

(defvar *bike-use-pclmul*
  #+(and sbcl x86-64 ironclad-unsafe-assembly) (pclmulqdq-supported-p)
  #-(and sbcl x86-64 ironclad-unsafe-assembly) nil)

(defun bike-mul-base (a b)
  "Constant-time carryless 64x64 product; returns low and high halves.
This is the portable path: the windowed table keeps the timing
independent of the operands."
  (let ((h 0) (l 0) (g1 0) (g2 0)
        (u (make-array 8 :initial-element 0))
        (w 64) (s 3)
        (a0 a) (b0 b))
    (let ((b0m (logand b0 #x1FFFFFFFFFFFFFFF)))
      (setf (aref u 0) 0
            (aref u 1) b0m
            (aref u 2) (ash b0m 1)
            (aref u 3) (logxor (ash b0m 1) b0m)
            (aref u 4) (ash b0m 2)
            (aref u 5) (logxor (ash b0m 2) b0m)
            (aref u 6) (ash (logxor (ash b0m 1) b0m) 1)
            (aref u 7) (logxor (ash (logxor (ash b0m 1) b0m) 1) b0m))
      (dotimes (i 8)
        (setf l (logxor l (logand (aref u i)
                                  (bike-u64eq (logand a0 7) i))))
        (setf l (logxor l (logand (ash (aref u i) 3)
                                  (bike-u64eq (logand (ash a0 -3) 7) i))))
        (setf h (logxor h (logand (ash (aref u i) -61)
                                  (bike-u64eq (logand (ash a0 -3) 7) i)))))
      (loop for i from (* 2 s) below w by (* 2 s)
            do (let ((i2 (+ i s)))
                 (setf g1 0 g2 0)
                 (dotimes (j 8)
                   (setf g1 (logxor g1 (logand (aref u j)
                                               (bike-u64eq (logand (ash a0 (- i)) 7) j))))
                   (setf g2 (logxor g2 (logand (aref u j)
                                               (bike-u64eq (logand (ash a0 (- i2)) 7) j)))))
                 (setf l (logxor l (ash g1 i) (ash g2 i2)))
                 (setf h (logxor h (ash g1 (- i w)) (ash g2 (- i2 w))))))
      (loop for i from 61 below 64
            do (let ((mask (if (zerop (logand (ash b0 (- i)) 1)) 0 #xFFFFFFFFFFFFFFFF)))
                 (setf l (logxor l (logand (ash a0 i) mask)))
                 (setf h (logxor h (logand (ash a0 (- i w)) mask)))))
      (values (logand l #xFFFFFFFFFFFFFFFF)
              (logand h #xFFFFFFFFFFFFFFFF)))))

(declaim (inline bike-clmul64))
(defun bike-clmul64 (a b)
  "Carryless 64x64 -> 128-bit product, as two values."
  #+(and sbcl x86-64 ironclad-unsafe-assembly)
  (if *bike-use-pclmul*
      (clmul64 a b)
      (bike-mul-base a b))
  #-(and sbcl x86-64 ironclad-unsafe-assembly)
  (bike-mul-base a b))

;;; The Karatsuba recursion addresses its operands by offset into the
;;; original simple arrays.  Displaced arrays have the general type
;;; `(array (unsigned-byte 64) (*))', so every limb access through one
;;; takes the generic AREF path; with offsets the whole recursion works
;;; on SIMPLE-ARRAYs and each limb is a single load.

(declaim (inline bike-kara-add1 bike-kara-add2 bike-kara-add3))
(defun bike-kara-add1 (sec alah blbh a ao b bo half)
  (declare (type (simple-array (unsigned-byte 64) (*)) sec a b)
           (type fixnum alah blbh ao bo half)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (dotimes (i half)
    (setf (aref sec (+ alah i))
          (logxor (aref a (+ ao i)) (aref a (+ ao i half))))
    (setf (aref sec (+ blbh i))
          (logxor (aref b (+ bo i)) (aref b (+ bo i half)))))
  (values))

(defun bike-kara-add2 (z zo x xo y yo half)
  (declare (type (simple-array (unsigned-byte 64) (*)) z x y)
           (type fixnum zo xo yo half)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (dotimes (i half)
    (setf (aref z (+ zo i))
          (logxor (aref x (+ xo i)) (aref y (+ yo i)))))
  (values))

(defun bike-kara-add3 (c co mid mo half)
  (declare (type (simple-array (unsigned-byte 64) (*)) c mid)
           (type fixnum co mo half)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (dotimes (i half)
    (let ((vt (aref mid (+ mo i))))
      (setf (aref c (+ co half i))
            (logxor vt (aref c (+ co half i)) (aref c (+ co i))))
      (setf (aref c (+ co (* 2 half) i))
            (logxor vt (aref c (+ co (* 2 half) i))
                    (aref c (+ co (* 3 half) i))))))
  (values))

(defun bike-karatsuba (c co a ao b bo qwords-len qwords-len-pad sec so)
  (declare (type (simple-array (unsigned-byte 64) (*)) c a b sec)
           (type fixnum co ao bo qwords-len qwords-len-pad so)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (if (<= qwords-len 1)
      (multiple-value-bind (l h) (bike-clmul64 (aref a ao) (aref b bo))
        (setf (aref c co) l
              (aref c (1+ co)) h))
      (let* ((half (ash qwords-len-pad -1))
             (alah so)
             (blbh (+ so half))
             (tmp (+ so (* 2 half)))
             (sec-next (+ so (* 3 half))))
        (declare (type fixnum half alah blbh tmp sec-next))
        (bike-karatsuba c co a ao b bo half half sec sec-next)
        (when (> qwords-len half)
          (bike-karatsuba c (+ co (* 2 half)) a (+ ao half) b (+ bo half)
                          (- qwords-len half) half sec sec-next)
          (bike-kara-add1 sec alah blbh a ao b bo half)
          (bike-kara-add2 sec tmp c (+ co half) c (+ co (* 2 half)) half)
          (bike-karatsuba c (+ co half) sec alah sec blbh half half sec sec-next)
          (bike-kara-add3 c co sec tmp half))
        (values))))

(defun bike-gf2x-mul-raw (t2 a b)
  (declare (type (simple-array (unsigned-byte 64) (*)) t2 a b)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let* ((pad (bike-r-padded-qwords))
         (sec (bike-u64vec (* 3 pad))))
    (declare (type fixnum pad))
    (bike-karatsuba t2 0 a 0 b 0 (bike-r-qwords) pad sec 0)
    (values)))

(defun bike-gf2x-red (c a)
  (declare (type (simple-array (unsigned-byte 64) (*)) c a)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords))
        (trail (bike-last-qword-trail))
        (lead (bike-last-qword-lead)))
    (declare (type fixnum rq trail lead))
    (dotimes (i rq)
      (let ((vt0 (aref a i))
            (vt1 (ash (aref a (+ i rq)) trail))
            (vt2 (ash (aref a (+ i rq -1)) (- lead))))
        (setf (aref c i) (logand (logxor vt0 vt1 vt2) #xFFFFFFFFFFFFFFFF))))
    (setf (aref c (1- rq))
          (logand (aref c (1- rq)) (bike-last-qword-mask)))
    (dotimes (i (- (bike-r-padded-qwords) rq))
      (setf (aref c (+ rq i)) 0))
    (values)))

(defun bike-gf2x-mul (c a b)
  (declare (type (simple-array (unsigned-byte 64) (*)) c a b)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((tmp (bike-u64vec (* 2 (bike-r-padded-qwords)))))
    (bike-gf2x-mul-raw tmp a b)
    (bike-gf2x-red c tmp)
    (values)))

(defun bike-gf2x-sqr (c a)
  "Square a polynomial, returning the (unreduced) 2r-bit result in TMP."
  (declare (type (simple-array (unsigned-byte 64) (*)) c a)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let* ((rq (bike-r-qwords))
         (tmp (bike-u64vec (* 2 (bike-r-padded-qwords)))))
    (declare (type fixnum rq))
    (dotimes (i rq)
      (multiple-value-bind (l h) (bike-clmul64 (aref a i) (aref a i))
        (setf (aref tmp (* 2 i)) l
              (aref tmp (1+ (* 2 i))) h)))
    (values tmp)))

(defun bike-gf2x-ksqr (c a l-param)
  (declare (type (simple-array (unsigned-byte 64) (*)) c a)
           (type fixnum l-param)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((r (bike-r-bits)))
    (declare (type fixnum r))
    (dotimes (i (bike-r-padded-qwords))
      (setf (aref c i) 0))
    ;; POS walks L*IDX modulo R incrementally: L < R, so one conditional
    ;; subtraction replaces the division that used to run per output bit.
    (let ((pos 0))
      (declare (type fixnum pos))
      (dotimes (idx r)
        (let ((bit (logand (ash (aref a (ash pos -6)) (- (logand pos 63))) 1)))
          (setf (aref c (ash idx -6))
                (logior (aref c (ash idx -6)) (ash bit (logand idx 63)))))
        (incf pos l-param)
        (when (>= pos r) (decf pos r))))
    (values)))

(defun bike-gf2x-sqr-mod (c a)
  (let ((tmp (bike-gf2x-sqr c a)))
    (bike-gf2x-red c tmp)
    (values)))

(defun bike-gf2x-repeated-sqr (c a n)
  (let ((pad (bike-r-padded-qwords)))
    (dotimes (i pad)
      (setf (aref c i) (aref a i)))
    (dotimes (i n)
      (bike-gf2x-sqr-mod c c))
    (values)))

(defun bike-gf2x-mul-mod (c a b)
  (bike-gf2x-mul c a b)
  (values))

(defun bike-gf2x-inv (c a)
  (let* ((pad (bike-r-padded-qwords))
         (max-i (bike-params-max-i *bike-params*))
         (exp0-k (bike-params-exp0-k *bike-params*))
         (exp0-l (bike-params-exp0-l *bike-params*))
         (exp1-k (bike-params-exp1-k *bike-params*))
         (exp1-l (bike-params-exp1-l *bike-params*))
         (tvec (bike-u64vec pad)))
    (dotimes (i pad)
      (setf (aref c i) (aref a i)
            (aref tvec i) (aref a i)))
    (let ((g (bike-u64vec pad)))
      (loop for i from 1 below max-i
            do (if (<= (aref exp0-k (1- i)) 64)
                   (bike-gf2x-repeated-sqr g c (aref exp0-k (1- i)))
                   (bike-gf2x-ksqr g c (aref exp0-l (1- i))))
               (bike-gf2x-mul-mod c g c)
               (unless (zerop (aref exp1-k i))
                 (if (<= (aref exp1-k i) 64)
                     (bike-gf2x-repeated-sqr g c (aref exp1-k i))
                     (bike-gf2x-ksqr g c (aref exp1-l i)))
                 (bike-gf2x-mul-mod tvec g tvec))))
    (bike-gf2x-sqr-mod tvec tvec)
    (dotimes (i pad)
      (setf (aref c i) (aref tvec i)))
    (values)))


;;;
;;; AES-256-CTR PRF.
;;;

(defstruct bike-prf
  (ctx nil)
  (ctr (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0))
  (buffer (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0))
  (pos 16 :type fixnum)
  (rem-calls #xFFFFFFFF :type (unsigned-byte 32)))

(defun bike-prf-init (seed32)
  (let ((ctx (make-cipher :aes :key (copy-seq seed32) :mode :ecb)))
    (make-bike-prf :ctx ctx)))

(defun bike-prf-perform (out out-start prf)
  (when (zerop (bike-prf-rem-calls prf))
    (error "BIKE PRF overused"))
  (aes-encrypt-block (bike-prf-ctx prf) (bike-prf-ctr prf) 0 out out-start)
  (let ((c 1))
    (dotimes (i 8)
      (let ((s (+ (aref (bike-prf-ctr prf) i) c)))
        (setf (aref (bike-prf-ctr prf) i) (logand s #xFF))
        (setf c (ash s -8)))))
  (decf (bike-prf-rem-calls prf))
  (values))

(defun bike-prf-output (out out-len prf)
  (let ((pos (bike-prf-pos prf)))
    (if (<= (+ out-len pos) 16)
        (progn
          (replace out (bike-prf-buffer prf)
                   :start1 0 :end1 out-len :start2 pos :end2 (+ pos out-len))
          (setf (bike-prf-pos prf) (+ pos out-len))
          (values))
        (let ((idx (- 16 pos)))
          (replace out (bike-prf-buffer prf)
                   :start1 0 :end1 idx :start2 pos :end2 16)
          (setf (bike-prf-pos prf) 0)
          (loop while (>= (- out-len idx) 16)
                do (bike-prf-perform out idx prf)
                   (incf idx 16))
          (bike-prf-perform (bike-prf-buffer prf) 0 prf)
          (let ((tail (- out-len idx)))
            (replace out (bike-prf-buffer prf)
                     :start1 idx :end1 out-len :start2 0 :end2 tail))
          (setf (bike-prf-pos prf) (- out-len idx))
          (values)))))


;;;
;;; Sparse sampling: Fisher-Yates indices + constant-time set-bits.
;;;

(declaim (inline bike-u32eq))
(defun bike-u32eq (a b)
  (if (= (logand a #xFFFFFFFF) (logand b #xFFFFFFFF))
      #xFFFFFFFF 0))

(defun bike-sample-fisher-yates (out num-indices max-idx prf)
  (let ((tmp (make-array 4 :element-type '(unsigned-byte 8))))
    (loop for i from (1- num-indices) downto 0
          do (bike-prf-output tmp 4 prf)
             (let* ((rand (logior (aref tmp 0)
                                  (ash (aref tmp 1) 8)
                                  (ash (aref tmp 2) 16)
                                  (ash (aref tmp 3) 24)))
                    (prod (* rand (- max-idx i)))
                    (l (+ i (ash prod -32)))
                    (is-dup 0))
               (loop for j from (1+ i) below num-indices
                     do (setf is-dup (logior is-dup
                                             (if (= l (aref out j)) 1 0))))
               (let ((mask (if (zerop is-dup) 0 #xFFFFFFFF)))
                 (setf (aref out i)
                       (logand #xFFFFFFFF
                               (logxor (logand mask i) (logand (lognot mask) l))))))))
  (values))

(defun bike-secure-set-bits (r first-pos wlist w-size)
  (let ((nwords (bike-r-padded-qwords)))
    (let ((pos-qw (make-array w-size :element-type '(unsigned-byte 32))))
      (let ((pos-bit (make-array w-size :element-type '(unsigned-byte 64))))
        (dotimes (i w-size)
          (let ((w (- (aref wlist i) first-pos)))
            (setf (aref pos-qw i) (logand (ash w -6) #xFFFFFFFF))
            (setf (aref pos-bit i) (ash 1 (logand w 63)))))
        (dotimes (i nwords)
          (let ((val 0))
            (dotimes (j w-size)
              (let ((w (- (aref wlist j) first-pos)))
                (when (>= w 0)
                  (setf val (logior val (logand (aref pos-bit j)
                                               (bike-u64eq-mask (aref pos-qw j) i)))))))
            (setf (aref r i) (logand val #xFFFFFFFFFFFFFFFF))))
        (values)))))

(defun bike-u64eq-mask (a b)
  (if (= (logand a #xFFFFFFFF) (logand b #xFFFFFFFF))
      #xFFFFFFFFFFFFFFFF 0))

(defun bike-generate-secret-key (h0 h1 wlist0 wlist1 seed32)
  (let ((prf (bike-prf-init seed32))
        (dd (bike-dd)))
    (let ((wt (make-array dd :element-type '(unsigned-byte 32) :initial-element 0)))
      (bike-sample-fisher-yates wt dd (bike-r-bits) prf)
      (dotimes (i dd) (setf (aref wlist0 i) (aref wt i)))
      (bike-secure-set-bits h0 0 wlist0 dd))
    (let ((wt (make-array dd :element-type '(unsigned-byte 32) :initial-element 0)))
      (bike-sample-fisher-yates wt dd (bike-r-bits) prf)
      (dotimes (i dd) (setf (aref wlist1 i) (aref wt i)))
      (bike-secure-set-bits h1 0 wlist1 dd))
    (values)))

(defun bike-mask-tail (e)
  (let* ((rb (bike-r-bytes))
         (pad (bike-r-padded-qwords))
         (lw (ash (1- rb) -3))
         (lp (logand (1- rb) 7)))
    (loop for i from (1+ lw) below pad
          do (setf (aref e i) 0))
    (let ((m (logior (1- (ash 1 (* 8 lp)))
                     (ash (bike-last-byte-mask) (* 8 lp)))))
      (setf (aref e lw) (logand (aref e lw) m))))
  (values))

(defun bike-generate-error-vector (e0 e1 seed32)
  (let ((prf (bike-prf-init seed32))
        (tt (bike-tt))
        (nbits (* 2 (bike-r-bits))))
    (let ((wlist (make-array tt :element-type '(unsigned-byte 32) :initial-element 0)))
      (bike-sample-fisher-yates wlist tt nbits prf)
      (bike-secure-set-bits e0 0 wlist tt)
      (bike-secure-set-bits e1 (bike-r-bits) wlist tt))
    (bike-mask-tail e0)
    (bike-mask-tail e1)
    (values)))
;;; BIKE decode helpers, chunk A.

(defun bike-l32-mask (v1 v2)
  (if (>= (logand v1 #xFFFFFFFF) (logand v2 #xFFFFFFFF))
      #xFFFFFFFF 0))

(defun bike-r-weight (r)
  (declare (type (simple-array (unsigned-byte 64) (*)) r)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((acc 0)
        (rb (bike-r-bytes)))
    (declare (type fixnum acc rb))
    (dotimes (i (1- rb))
      (incf acc (logcount (bike-get-u8 r i))))
    (+ acc (logcount (logand (bike-get-u8 r (1- rb))
                             (bike-last-byte-mask))))))

(declaim (inline bike-get-u8))
(defun bike-get-u8 (v j)
  (declare (type (simple-array (unsigned-byte 64) (*)) v)
           (type fixnum j)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (ldb (byte 8 (ash (logand j 7) 3)) (aref v (ash j -3))))

(defun bike-syndrome-dup (s)
  (declare (type (simple-array (unsigned-byte 64) (*)) s)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords))
        (lead (bike-last-qword-lead))
        (trail (bike-last-qword-trail))
        (last-mask (bike-last-qword-mask)))
    (declare (type fixnum rq lead trail)
             (type (unsigned-byte 64) last-mask))
    (setf (aref s (1- rq))
          (logior (logand (ash (aref s 0) lead) #xFFFFFFFFFFFFFFFF)
                  (logand (aref s (1- rq)) last-mask)))
    (dotimes (i (1- (* 2 rq)))
      (setf (aref s (+ rq i))
            (logior (ash (aref s i) (- trail))
                    (logand (ash (aref s (1+ i)) lead) #xFFFFFFFFFFFFFFFF))))
    (values)))

(defun bike-rotr-big (out inn qw-num)
  (declare (type (simple-array (unsigned-byte 64) (*)) out inn)
           (type fixnum qw-num)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords)))
    (declare (type fixnum rq))
    (dotimes (i (* 3 rq))
      (setf (aref out i) (aref inn i)))
    (let ((half-log 1))
      (declare (type fixnum half-log))
      (loop while (< half-log (ash rq -1))
            do (setf half-log (ash half-log 1)))
      (loop for idx of-type fixnum = half-log then (ash idx -1)
            while (>= idx 1)
            do (let ((mask (if (>= qw-num idx) #xFFFFFFFFFFFFFFFF 0)))
                 (declare (type (unsigned-byte 64) mask))
                 (setf qw-num (- qw-num (logand idx mask)))
                 (dotimes (i (+ rq idx))
                   (let ((a (aref out i))
                         (b (aref out (+ i idx))))
                     ;; select B where MASK is all ones, else A; written
                     ;; this way the step stays unboxed 64-bit arithmetic
                     ;; with no LOGNOT.
                     (setf (aref out i)
                           (logxor a (logand (logxor a b) mask))))))))
    (values)))

(defun bike-rotr-small (out inn bits)
  (declare (type (simple-array (unsigned-byte 64) (*)) out inn)
           (type fixnum bits)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords)))
    (declare (type fixnum rq))
    (let ((mask (if (zerop bits) 0 #xFFFFFFFFFFFFFFFF))
          (high-shift (if (zerop bits) 0 (- 64 bits))))
      (declare (type (unsigned-byte 64) mask)
               (type fixnum high-shift))
      (dotimes (i rq)
        (setf (aref out i)
              (logior (ash (aref inn i) (- bits))
                      (logand (ash (aref inn (1+ i)) high-shift) mask))))
      (values))))

(defun bike-rotate-right (out inn bitscount)
  (declare (type (simple-array (unsigned-byte 64) (*)) out inn)
           (type fixnum bitscount)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (bike-rotr-big out inn (ash bitscount -6))
  (bike-rotr-small out out (logand bitscount 63))
  (values))

(declaim (inline bike-bit-sliced-adder))
(defun bike-bit-sliced-adder (upc rotated num-slices)
  (declare (type simple-vector upc)
           (type (simple-array (unsigned-byte 64) (*)) rotated)
           (type fixnum num-slices)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords)))
    (declare (type fixnum rq))
    (dotimes (j num-slices)
      (let ((slice (the (simple-array (unsigned-byte 64) (*)) (aref upc j))))
        (declare (type (simple-array (unsigned-byte 64) (*)) slice))
        (dotimes (i rq)
          (let ((carry (logand (aref slice i) (aref rotated i))))
            (setf (aref slice i) (logxor (aref slice i) (aref rotated i)))
            (setf (aref rotated i) carry))))))
  (values))

(defun bike-slice-subtract (upc threshold)
  (declare (type simple-vector upc)
           (type (unsigned-byte 64) threshold)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((rq (bike-r-qwords))
        (nslices (length upc))
        (br (bike-u64vec (bike-r-qwords)))
        (val threshold)
        (ones #xFFFFFFFFFFFFFFFF))
    (declare (type fixnum rq nslices)
             (type (unsigned-byte 64) val ones))
    (dotimes (j nslices)
      (let ((slice (the (simple-array (unsigned-byte 64) (*)) (aref upc j)))
            ;; all ones iff VAL is odd, without a branch
            (lsb (logand (- (logand val 1)) #xFFFFFFFFFFFFFFFF)))
        (declare (type (simple-array (unsigned-byte 64) (*)) slice)
                 (type (unsigned-byte 64) lsb))
        (setf val (ash val -1))
        (dotimes (i rq)
          (let* ((a (aref slice i))
                 (nbr (aref br i))
                 (na (logxor a ones))
                 (nnbr (logxor nbr ones))
                 (t1 (logand na lsb nnbr))
                 (t2 (logand (logior na lsb) nbr)))
            (setf (aref slice i) (logxor a lsb nbr))
            (setf (aref br i) (logior t1 t2))))))
    (values)))

(defun bike-log2-msb (v)
  (cond ((zerop v) 0)
        ((< v 2) 1)
        ((< v 4) 2)
        ((< v 8) 3)
        ((< v 16) 4)
        ((< v 32) 5)
        ((< v 64) 6)
        ((< v 128) 7)
        ((< v 256) 8)
        (t 9)))

(defun bike-slices ()
  (1+ (bike-log2-msb (bike-dd))))

(defun bike-delta () 3)

(defun bike-upc-byte (upc j)
  (declare (type simple-vector upc) (type fixnum j)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
