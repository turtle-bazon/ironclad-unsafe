(defun bike-keypair-from-seeds (seed0 seed1)
  (let ((pad (bike-r-padded-qwords)))
    (let ((rb (bike-r-bytes)))
      (let ((dd (bike-dd)))
        (let ((h0 (bike-u64vec pad)))
          (let ((h1 (bike-u64vec pad)))
            (let ((w0 (make-array dd :element-type '(unsigned-byte 32) :initial-element 0)))
              (let ((w1 (make-array dd :element-type '(unsigned-byte 32) :initial-element 0)))
                (bike-generate-secret-key h0 h1 w0 w1 seed0)
                (let ((h0inv (bike-u64vec pad)))
                  (let ((h (bike-u64vec pad)))
                    (bike-gf2x-inv h0inv h0)
                    (bike-gf2x-mul h h1 h0inv)
                    (let ((pk (make-array (bike-pk-bytes) :element-type '(unsigned-byte 8) :initial-element 0)))
                      (let ((sk (make-array (bike-sk-bytes) :element-type '(unsigned-byte 8) :initial-element 0)))
                        (bike-words-to-bytes pk h rb)
                        (bike-store-sk sk w0 w1 h0 h1 h seed1)
                        (values pk sk)))))))))))))

(defun bike-generate-keypair ()
  (bike-keypair-from-seeds (ironclad-unsafe:random-data 32) (ironclad-unsafe:random-data 32)))

(defun bike-encrypt-ct (c0 c1 e0 e1 h-words m)
  (let ((pad (bike-r-padded-qwords)))
    (let ((rb (bike-r-bytes)))
      (let ((pe0 (bike-u64vec pad)))
        (let ((pe1 (bike-u64vec pad)))
          (bike-bytes-to-words pe0 e0 rb)
          (bike-bytes-to-words pe1 e1 rb)
          (let ((ct (bike-u64vec pad)))
            (bike-gf2x-mul ct pe1 h-words)
            (bike-gf2x-add ct ct pe0 pad)
            (bike-words-to-bytes c0 ct rb)
            (let ((lv (bike-function-l e0 e1)))
              (dotimes (i 32)
                (setf (aref c1 i) (logxor (aref lv i) (aref m i))))
              (values))))))))

(defun bike-kem-encaps-deterministic (m seed-e pk-bytes)
  (let ((rb (bike-r-bytes)))
    (let ((e0w (bike-u64vec (bike-r-padded-qwords))))
      (let ((e1w (bike-u64vec (bike-r-padded-qwords))))
        (bike-generate-error-vector e0w e1w seed-e)
        (let ((e0 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0)))
          (let ((e1 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0)))
            (bike-words-to-bytes e0 e0w rb)
            (bike-words-to-bytes e1 e1w rb)
            (let ((c0 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0)))
              (let ((c1 (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0)))
                (let ((h (bike-u64vec (bike-r-padded-qwords))))
                  (bike-bytes-to-words h pk-bytes rb)
                  (bike-encrypt-ct c0 c1 e0 e1 h m)
                  (let ((ct (make-array (bike-ct-bytes) :element-type '(unsigned-byte 8))))
                    (let ((ss (bike-function-k m c0 c1)))
                      (replace ct c0)
                      (replace ct c1 :start1 rb)
                      (values ct ss))))))))))))

(defun bike-kem-decaps (ct sk-bytes)
  (let* ((rb (bike-r-bytes))
         (dd (bike-dd))
         (c0 (subseq ct 0 rb))
         (c1 (subseq ct rb (+ rb 32)))
         (w0 (make-array dd :element-type '(unsigned-byte 32)))
         (w1 (make-array dd :element-type '(unsigned-byte 32)))
         (sigma (make-array 32 :element-type '(unsigned-byte 8)))
         (e0 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0))
         (e1 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0)))
    (bike-load-wlists-sigma w0 w1 sigma sk-bytes)
    (bike-decode e0 e1 c0
                 (bike-sk-h0-bytes sk-bytes)
                 (bike-sk-pk-bytes sk-bytes)
                 w0 w1)
    (let* ((lv (bike-function-l e0 e1))
           (mp (make-array 32 :element-type '(unsigned-byte 8)))
           (terr0 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0))
           (terr1 (make-array rb :element-type '(unsigned-byte 8) :initial-element 0)))
      (dotimes (i 32)
        (setf (aref mp i) (logxor (aref c1 i) (aref lv i))))
      (let ((terr0w (bike-u64vec (bike-r-padded-qwords))))
        (let ((terr1w (bike-u64vec (bike-r-padded-qwords))))
          (bike-generate-error-vector terr0w terr1w mp)
          (bike-words-to-bytes terr0 terr0w rb)
          (bike-words-to-bytes terr1 terr1w rb)))
      (let ((ok (and (equalp terr0 e0) (equalp terr1 e1))))
        (bike-function-k (if ok mp sigma) c0 c1)))))
;;; BIKE public API: key classes, generation, encapsulation.

(defclass bike-key ()
  ((kind :initarg :kind :reader bike-key-kind)
   (bytes :initarg :bytes :reader bike-key-bytes)))

(defclass bike-public-key (bike-key)
  ())

(defclass bike-private-key (bike-key)
  ())

(defclass bike-l1-public-key (bike-public-key)
  ())

(defclass bike-l1-private-key (bike-private-key)
  ())

(defclass bike-l3-public-key (bike-public-key)
  ())

(defclass bike-l3-private-key (bike-private-key)
  ())

(defclass bike-l5-public-key (bike-public-key)
  ())

(defclass bike-l5-private-key (bike-private-key)
  ())

(defun bike-check-bytes (bytes length kind)
  (unless (and (typep bytes '(simple-array (unsigned-byte 8) (*)))
               (= (length bytes) length))
    (error 'missing-key-parameter
           :kind kind
           :parameter 'bytes
           :description "BIKE key bytes"))
  (copy-seq bytes))

(defmacro bike-define-key-constructors (kind public-class private-class)
  `(progn
     (defmethod make-public-key ((kind (eql ,kind)) &key bytes &allow-other-keys)
       (let ((*bike-params* (bike-params-for-kind ,kind)))
         (make-instance ',public-class :kind ,kind
                        :bytes (bike-check-bytes bytes (bike-pk-bytes) ,kind))))
     (defmethod make-private-key ((kind (eql ,kind)) &key bytes &allow-other-keys)
       (let ((*bike-params* (bike-params-for-kind ,kind)))
         (make-instance ',private-class :kind ,kind
                        :bytes (bike-check-bytes bytes (bike-sk-bytes) ,kind))))
     (defmethod generate-key-pair ((kind (eql ,kind)) &key &allow-other-keys)
       (let ((*bike-params* (bike-params-for-kind ,kind)))
         (multiple-value-bind (pk sk) (bike-generate-keypair)
           (values (make-private-key ,kind :bytes sk)
                   (make-public-key ,kind :bytes pk)))))))

(bike-define-key-constructors :bike-l1 bike-l1-public-key bike-l1-private-key)
(bike-define-key-constructors :bike-l3 bike-l3-public-key bike-l3-private-key)
(bike-define-key-constructors :bike-l5 bike-l5-public-key bike-l5-private-key)

(defmethod destructure-public-key ((public-key bike-public-key))
  (list :bytes (copy-seq (bike-key-bytes public-key))))

(defmethod destructure-private-key ((private-key bike-private-key))
  (list :bytes (copy-seq (bike-key-bytes private-key))))

(defmethod encapsulate-key ((public-key bike-public-key))
  (let* ((kind (bike-key-kind public-key))
         (*bike-params* (bike-params-for-kind kind)))
    (let ((m (random-data 32)))
      (bike-kem-encaps-deterministic m m (bike-key-bytes public-key)))))

(defmethod decapsulate-key ((private-key bike-private-key) ciphertext)
  (let* ((kind (bike-key-kind private-key))
         (*bike-params* (bike-params-for-kind kind)))
    (unless (and (typep ciphertext '(simple-array (unsigned-byte 8) (*)))
                 (= (length ciphertext) (bike-ct-bytes)))
      (error 'invalid-message-length :kind kind))
    (bike-kem-decaps ciphertext (bike-key-bytes private-key))))
