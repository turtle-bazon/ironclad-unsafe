(defun bike-accumulate-upc (upc rot s wlist)
  (declare (type simple-vector upc)
           (type (simple-array (unsigned-byte 64) (*)) rot s)
           (type (simple-array (unsigned-byte 32) (*)) wlist)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((dd (bike-dd)))
    (declare (type fixnum dd))
    (dotimes (j dd)
      (bike-rotate-right rot s (aref wlist j))
      (bike-bit-sliced-adder upc rot (bike-log2-msb (1+ j)))))
