(defun bike-delta-ones (upc rot)
  (declare (type simple-vector upc)
           (type (simple-array (unsigned-byte 64) (*)) rot)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let ((delta (bike-delta))
        (rb (bike-r-bytes))
        (ns (bike-slices)))
    (declare (type fixnum delta rb ns))
    (dotimes (l delta)
      (dotimes (i rb)
        (bike-set-byte rot i #xFF))
      (bike-bit-sliced-adder upc rot ns)))
  (values))

(defun bike-find-err1 (e black gray s wlists threshold)
  (declare (type simple-vector e black gray wlists)
           (type (simple-array (unsigned-byte 64) (*)) s)
           (type (unsigned-byte 64) threshold)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (dotimes (ii 2)
    (let ((upc (bike-new-upc))
          (rot (bike-u64vec (* 3 (bike-r-qwords)))))
      (bike-accumulate-upc upc rot s (aref wlists ii))
      (bike-slice-subtract upc threshold)
      (bike-err1-black (aref e ii) (aref black ii) upc)
      (bike-delta-ones upc rot)
      (bike-err1-gray (aref gray ii) (aref black ii) upc)))
  (values))

