(defun bike-err1-black (e black upc)
  (declare (type (simple-array (unsigned-byte 8) (*)) e black)
           (type simple-vector upc)
           (optimize (speed 3) (safety 0) (space 0) (debug 0)))
  (let* ((rb (bike-r-bytes))
         (slice (the (simple-array (unsigned-byte 64) (*))
                     (aref upc (1- (bike-slices))))))
    (declare (type fixnum rb)
             (type (simple-array (unsigned-byte 64) (*)) slice))
    (dotimes (j rb)
      (let ((sum (logxor (ldb (byte 8 (ash (logand j 7) 3))
                              (aref slice (ash j -3)))
                         #xFF)))
        (declare (type (unsigned-byte 8) sum))
        (setf (aref black j) sum)
        (setf (aref e j) (logxor (aref e j) sum))))
    (setf (aref e (1- rb))
          (logand (aref e (1- rb)) (bike-last-byte-mask)))
    (values)))

(defun bike-err1-gray (gray black upc)
