(defun bike-sha384 (input outlen)
  (let ((d (ironclad-unsafe:make-digest :sha384)))
    (ironclad-unsafe:update-digest d input)
    (subseq (ironclad-unsafe:produce-digest d) 0 outlen)))

(defun bike-words-to-bytes (out words nbytes)
  (dotimes (i nbytes)
    (setf (aref out i) (ldb (byte 8 (* (mod i 8) 8)) (aref words (ash i -3)))))
  (values))

(defun bike-function-l (e0 e1)
  (let ((rb (bike-r-bytes)))
    (let ((tmp (make-array (* 2 rb) :element-type '(unsigned-byte 8))))
      (replace tmp e0)
      (replace tmp e1 :start1 rb)
      (bike-sha384 tmp 32))))

(defun bike-function-k (m c0 c1)
  (let ((rb (bike-r-bytes)))
    (let ((tmp (make-array (+ 32 rb 32) :element-type '(unsigned-byte 8))))
      (replace tmp m)
      (replace tmp c0 :start1 32)
      (replace tmp c1 :start1 (+ 32 rb))
      (bike-sha384 tmp 32))))

(defun bike-store-sk (sk w0 w1 h0 h1 h sigma)
  (let ((dd (bike-dd)))
    (let ((rb (bike-r-bytes)))
      (let ((off (* 4 dd)))
        (dotimes (i (* 4 dd))
          (setf (aref sk i)
                (ldb (byte 8 (* (mod i 4) 8)) (aref w0 (ash i -2))))
          (setf (aref sk (+ off i))
                (ldb (byte 8 (* (mod i 4) 8)) (aref w1 (ash i -2)))))
        (setf off (* 8 dd))
        (dotimes (i rb)
          (setf (aref sk (+ off i)) (bike-get-u8 h0 i)))
        (setf off (+ (* 8 dd) rb))
        (dotimes (i rb)
          (setf (aref sk (+ off i)) (bike-get-u8 h1 i)))
        (setf off (+ (* 8 dd) (* 2 rb)))
        (dotimes (i rb)
          (setf (aref sk (+ off i)) (bike-get-u8 h i)))
        (setf off (+ (* 8 dd) (* 3 rb)))
        (replace sk sigma :start1 off)
        sk))))

(defun bike-load-wlists-sigma (w0 w1 sigma sk)
  (let ((dd (bike-dd)))
    (dotimes (i dd)
      (setf (aref w0 i)
            (logior (aref sk (* 4 i))
                    (ash (aref sk (+ (* 4 i) 1)) 8)
                    (ash (aref sk (+ (* 4 i) 2)) 16)
                    (ash (aref sk (+ (* 4 i) 3)) 24)))
      (setf (aref w1 i)
            (logior (aref sk (+ (* 4 dd) (* 4 i)))
                    (ash (aref sk (+ (* 4 dd) (* 4 i) 1)) 8)
                    (ash (aref sk (+ (* 4 dd) (* 4 i) 2)) 16)
                    (ash (aref sk (+ (* 4 dd) (* 4 i) 3)) 24))))
    (replace sigma (subseq sk (+ (* 8 dd) (* 3 (bike-r-bytes)))))
    (values)))

