                              (aref slice (ash j -3)))
                         #xFF)))
        (declare (type (unsigned-byte 8) sum))
        (setf (aref e j) (logxor (aref e j) (logand (aref pos-e j) sum)))))
    (setf (aref e (1- rb))
          (logand (aref e (1- rb)) (bike-last-byte-mask)))
