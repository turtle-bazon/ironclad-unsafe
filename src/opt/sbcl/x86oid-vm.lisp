                 (inst mov tmp (m64 j))
                 (inst mul tmp)
                 (inst add rax-tmp (t64 (+ i j)))
                 (inst adc rdx-tmp 0)
                 (inst add rax-tmp carry)
                 (inst adc rdx-tmp 0)
                 (inst mov (t64 (+ i j)) rax-tmp)
                 (inst mov carry rdx-tmp))
