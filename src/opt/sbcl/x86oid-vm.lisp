           append
           (list `(inst mov :dword t0 (ea (+ disp (* 4 (+ 8 ,j))) buf))
                 `(inst xor :dword t0 (ea (+ disp (* 4 (+ 8 ,(+ j 4)))) buf))
                 `(inst mov :dword (ea (+ disp (* 4 (+ 76 ,j))) buf) t0))))))

(defmacro sm3-schedule-body ()
  (cons 'progn (sm3-schedule-forms)))

#+x86-64
