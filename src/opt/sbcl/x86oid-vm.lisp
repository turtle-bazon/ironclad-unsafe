;;;; -*- mode: lisp; indent-tabs-mode: nil -*-
;;;; IMPORTANT: the VOPs below address their array arguments with a
;;;; fixed offset from the array descriptor (see the DATA-OFFSET
;;;; computations), which assumes the usual heap layout of a simple
;;;; vector.  An array that lives on the stack -- because it is
;;;; declared DYNAMIC-EXTENT, or because SBCL's escape analysis
;;;; stack-allocates it -- has a different layout, and the VOP then
;;;; reads and writes outside the array, silently corrupting the
;;;; caller's stack frame.  Never pass a stack-allocated array to a
;;;; VOP; keep such scratch vectors in the heap.

#+(and sbcl (or x86 x86-64) ironclad-unsafe-assembly)
(defpackage :ironclad-unsafe-vm
  ;; more recent SBCL exports various symbols making this package
  ;; definition more concise. This is the backward-compatible way.
  (:use #:common-lisp
        #:sb-c     ; for DEFINE-VOP and SC-IS
        #:sb-assem ; for INST, GEN-LABEL
        #:sb-vm)   ; for primtype names, SCs, constants
  (:shadow #:ea) ; in case SB-VM exports it
  (:import-from #:sb-vm
                #:positive-fixnum #:unsigned-num
                #:descriptor-reg #:unsigned-reg #:double-reg #:immediate
                #+x86-64 #:int-sse-reg #+x86-64 #:int-avx2-reg
                #:simple-array-unsigned-byte-8
                #:simple-array-unsigned-byte-32
                #+x86-64 #:simple-array-unsigned-byte-64
                #+x86-64 #:rax-offset #+x86-64 #:rcx-offset
       #+x86-64 #:rdx-offset))

#+(and sbcl (or x86 x86-64) ironclad-unsafe-assembly)
(in-package :ironclad-unsafe-vm)

#+(and sbcl x86 ironclad-unsafe-assembly)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun ea (displacement &optional base index (scale 1))
    (sb-vm::make-ea :dword
                    :base base
                    :index index
                    :scale scale
                    :disp (or displacement 0)))
  (setf (fdefinition 'dword-ea) (fdefinition 'ea))
  (defmacro dword-inst (name &rest operands)
    `(inst ,name ,@operands)))

#+(and sbcl x86-64 ironclad-unsafe-assembly)
(eval-when (:compile-toplevel :load-toplevel :execute)
  #+ironclad-unsafe-sb-vm-ea
  (progn ; Newer SBCL (>= 1.4.11)
    (setf (fdefinition 'ea) (fdefinition 'sb-vm::ea))
    (setf (fdefinition 'dword-ea) (fdefinition 'ea))
    (defmacro dword-inst (name &rest operands)
      (case name
        (bswap
         ;; The '(bswap :dword r)' notation is only supported
         ;; on SBCL > 1.5.9.
         (if (ignore-errors (sb-ext:assert-version->= 1 5 9 17) t)
             `(inst bswap :dword ,@operands)
             `(inst bswap (sb-vm::reg-in-size ,@operands :dword))))
        (t
         `(inst ,name :dword ,@operands)))))
  #-ironclad-unsafe-sb-vm-ea
  (progn ; Older SBCL (< 1.4.11)
    (defun ea (displacement &optional base index (scale 1))
      (sb-vm::make-ea :qword
                      :base base
                      :index index
                      :scale scale
                      :disp (or displacement 0)))
    (defun dword-ea (displacement &optional base index (scale 1))
      (sb-vm::make-ea :dword
                      :base base
                      :index index
                      :scale scale
                      :disp (or displacement 0)))
    (defmacro dword-inst (name &rest operands)
      `(inst ,name ,@(mapcar (lambda (operand)
                               `(if (tn-p ,operand)
                                    (sb-vm::reg-in-size ,operand :dword)
                                    ,operand))
                             operands)))))

